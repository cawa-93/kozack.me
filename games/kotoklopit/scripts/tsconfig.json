{
  // Скрипти для Node (знімки, пізніше конвеєр арту): окремо від коду гри, щоб типи Node й DOM-обгортки скриптів
  // не змішувалися з браузерним кодом src/. Node 26 запускає .ts сам, тож лише синтаксис, який можна просто стерти.
  // Пошук модулів — як у збирача (bundler), не NodeNext: скрипти імпортують код гри (типи арту й скелета з src/view/),
  // а він пише відносні імпорти без розширень; плагін конвеєра імпортує й vite.config.ts, тож там теж без розширень.
  // Через це tsc не помітить відносного імпорту без розширення у скрипті, який запускає сам Node: там пишіть `.ts`.
  "compilerOptions": {
    "target": "ES2024",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["**/*.ts"]
}
