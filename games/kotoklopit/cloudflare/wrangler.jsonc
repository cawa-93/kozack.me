// Музика радіо на статичному хостингу Cloudflare (§8.10, SOUND_PLAN.md, блок 3): лише файли, без коду Worker.
// Запити до статичних файлів безкоштовні й без ліміту; файлів — до 20 000 на версію (це перевіряє scripts/audio/encode.ts).
// Тека — результат `npm run audio:encode -- --out audio-out`; `_headers` у ній дозволяє гру з іншого домену й довгий кеш.
{
  "name": "kotoklopit-radio",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "../audio-out/radio",
    "not_found_handling": "none"
  }
}
